# Copy this file to .env and fill in what you need. Nothing here is required for the smoke test.

# Hugging Face token: needed only for gated models (Llama 3.2, Gemma 2).
# Get one free at https://huggingface.co/settings/tokens and accept each model's licence on its page.
HF_TOKEN=

# Only if you set experiment_llm.backend: openai in configs/study.yaml
# Local servers (vLLM, Ollama) usually accept any key.
OPENAI_API_KEY=
OPENAI_BASE_URL=
